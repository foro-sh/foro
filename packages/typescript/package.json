{
    "name": "@foro-sh/foro",
    "version": "0.8.0",
    "description": "TypeScript SDK for Foro",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./manifest-cases": {
            "types": "./dist/manifest-cases.d.ts",
            "import": "./dist/manifest-cases.js",
            "default": "./dist/manifest-cases.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "node scripts/generate-manifest-cases.mjs && tsc -p tsconfig.json",
        "prepublishOnly": "npm run build",
        "test": "node --test dist/**/*.test.js"
    },
    "publishConfig": {
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/foro-sh/foro.git"
    },
    "homepage": "https://github.com/foro-sh/foro",
    "bugs": {
        "url": "https://github.com/foro-sh/foro/issues"
    },
    "license": "MIT",
    "keywords": [
        "foro",
        "sdk",
        "typescript",
        "api"
    ],
    "engines": {
        "node": ">=18"
    },
    "devDependencies": {
        "typescript": "^5.6.3"
    }
}
